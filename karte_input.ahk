; ============================================================
; ユーティリティ関数
; ============================================================

CheckWindow() {
    if !WinActive("診療入力") {
        MsgBox("エキスパートシステムの診療入力画面をアクティブにしてください。")
        return false
    }
    return true
}

EC(code) {
    global DELAY
    SendInput(code)
    SendInput("{Enter}")
    Sleep(DELAY)
}

EX(text) {
    global DELAY
    oldClip := ClipboardAll()
    A_Clipboard := String(text)
    ClipWait(2)
    SendInput("^v")
    SendInput("{Enter}")
    Sleep(DELAY)
    A_Clipboard := oldClip
}

Pick2(arr, &i1, &i2) {
    n := arr.Length
    i1 := Random(1, n)
    loop {
        i2 := Random(1, n)
        if (i2 != i1)
            break
    }
}

PickExclude(arr, exclude) {
    n := arr.Length
    loop {
        idx := Random(1, n)
        if (idx != exclude)
            break
    }
    return idx
}

Input2Random(arr) {
    Pick2(arr, &i1, &i2)
    EX(arr[i1])
    EX(arr[i2])
}


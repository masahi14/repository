generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Staff {
  id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  color       String                 @default("#1d4ed8")
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz
  assignments StageAssignmentStaff[]

  @@map("staff")
}

model Patient {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientName String   @map("patient_name")
  patientId   String?  @map("patient_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  cases       Case[]

  @@map("patient")
}

model Case {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId    String            @map("patient_id") @db.Uuid
  caseType     String            @default("初回") @map("case_type")
  currentStage Int               @default(1) @map("current_stage")
  note         String?
  deadline     DateTime?         @db.Date
  yellowDays   Int               @default(3) @map("yellow_days")
  redDays      Int               @default(1) @map("red_days")
  archived     Boolean           @default(false)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  patient      Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  assignments  StageAssignment[]
  activityLogs ActivityLog[]

  @@map("treatment_case")
}

model StageAssignment {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId           String                 @map("case_id") @db.Uuid
  stage            Int
  assignedAt       DateTime               @default(now()) @map("assigned_at") @db.Timestamptz
  completedAt      DateTime?              @map("completed_at") @db.Timestamptz
  case             Case                   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  staffAssignments StageAssignmentStaff[]

  @@map("stage_assignment")
}

model StageAssignmentStaff {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stageAssignmentId String          @map("stage_assignment_id") @db.Uuid
  staffId           String          @map("staff_id") @db.Uuid
  stageAssignment   StageAssignment @relation(fields: [stageAssignmentId], references: [id], onDelete: Cascade)
  staff             Staff           @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([stageAssignmentId, staffId])
  @@map("stage_assignment_staff")
}

model ActivityLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId    String?  @map("case_id") @db.Uuid
  action    String
  detail    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  case      Case?    @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@map("activity_log")
}
